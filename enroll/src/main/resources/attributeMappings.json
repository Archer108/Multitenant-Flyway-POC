{
  "ParticipantSSN":
  {
    "jsonPointer": "/participantRevisions",
    "leafPointer": "/personal/socialSecurityNumber",
    "label":       "Participant SSN",
    "regex": "^([0-9]{3}-[0-9]{2}-[0-9]{4}|[0-9]{9})$"
  },
  "DependentsSSN":
  {
    "jsonPointer": "/dependents",
    "leafPointer": "/personal/socialSecurityNumber",
    "label":       "Dependent SSN",
    "regex": "^([0-9]{3}-[0-9]{2}-[0-9]{4}|[0-9]{9})$"
  },
  "BeneficiariesSSN":
  {
    "jsonPointer": "/beneficiaries",
    "leafPointer": "/person/socialSecurityNumber",
    "label":       "Beneficiary SSN",
    "regex": "^([0-9]{3}-[0-9]{2}-[0-9]{4}|[0-9]{9})$"
  },
  "UUID": [
    {
      "jsonPointer": "/transmissionGUID",
      "leafPointer": "",
      "label":       "Transmission GUID",
      "regex": "^[0-9A-Fa-f]{8}(?:-[0-9A-Fa-f]{4}){3}-[0-9A-Fa-f]{12}$"

    },
    {
      "jsonPointer": "/correlationID",
      "leafPointer": "",
      "label":       "Correlation GUID",
      "regex": "^[0-9A-Fa-f]{8}(?:-[0-9A-Fa-f]{4}){3}-[0-9A-Fa-f]{12}$"
    }
  ],
  "DATE_OF_BIRTH_CANONICAL": {
    "jsonPointer": "/worker",
    "leafPointer": "/person",
    "label": "Date of Birth",
    "regex": "^\\d{4}-\\d{2}-\\d{2}$"
  }
}
